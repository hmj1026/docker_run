# ================================================
# POSDEV Docker 環境變數配置範本
# ================================================
# 複製此檔案為 .env 並修改為您的實際路徑

# ================================================
# 版本控制
# ================================================
# PHP 版本 (可選: 56, 74, 80, 81, 82, 83)
PHP_VERSION=56

# MySQL 版本 (可選: 5.7, 8.0, 8.4)
MYSQL_VERSION=5.7

# Nginx 版本
NGINX_VERSION=1.24-alpine

# ================================================
# 網路 PORT 設定
# ================================================
# HTTP PORT (需與 Laragon 相同)
HTTP_PORT=80

# HTTPS PORT (需與 Laragon 相同)
HTTPS_PORT=443

# MySQL PORT (需與 Laragon 相同)
MYSQL_PORT=3306

# ================================================
# 資料庫認證
# ================================================
# MySQL Root 密碼 (開發環境可留空)
MYSQL_ROOT_PASSWORD=

# 應用程式資料庫名稱
MYSQL_DATABASE=posdev_dev

# 應用程式資料庫使用者
MYSQL_USER=root

# 應用程式資料庫密碼
MYSQL_PASSWORD=

# ================================================
# 專案路徑映射
# ================================================
# 重要：本專案採用「分散管理模式」
# - pos_dev 和 yii_framework 是獨立開發目錄
# - www.posdev 包含各商戶入口（dev, xxoo 等）
# - Docker 會將獨立目錄掛載到 www.posdev 的子目錄中
#
# 依作業系統填入對應格式：
#   Linux / WSL2:            /home/<username>/projects/...
#   macOS:                   /Users/<username>/projects/...
#   Windows (Docker Desktop): C:/Users/<username>/projects/... (使用正斜線)

# POS 主程式目錄（獨立）V1專案資料夾 假設為 pos_dev
PROJECT_PATH=/home/<username>/projects/pos_dev
# PROJECT_PATH=/Users/<username>/projects/pos_dev          # macOS
# PROJECT_PATH=C:/Users/<username>/projects/pos_dev        # Windows Docker Desktop

# 容器內掛載目標路徑（自行設定，勿寫入公開 repo）
PROJECT_CONTAINER_PATH=/var/www/www.posdev/myproject

# OKL
PROJECT_OKL_PATH=/home/<username>/projects/pos_okl
# PROJECT_OKL_PATH=/Users/<username>/projects/pos_okl
# PROJECT_OKL_PATH=C:/Users/<username>/projects/pos_okl

# 容器內掛載目標路徑
PROJECT_OKL_CONTAINER_PATH=/var/www/www.posdev/myproject-v2

# 社區 主程式目錄（獨立）202 301專案資料夾 假設為 conductor_dev
# 容器內對應：/var/www/www.posdev/conductor_dev
PROJECT_CONDUCTOR_PATH=/home/<username>/projects/conductor_dev
# PROJECT_CONDUCTOR_PATH=/Users/<username>/projects/conductor_dev
# PROJECT_CONDUCTOR_PATH=C:/Users/<username>/projects/conductor_dev

# Yii Framework 目錄（獨立）
# 容器內對應：/var/www/www.posdev/yii_framework
YII_FRAMEWORK_PATH=/home/<username>/projects/yii_framework
# YII_FRAMEWORK_PATH=/Users/<username>/projects/yii_framework
# YII_FRAMEWORK_PATH=C:/Users/<username>/projects/yii_framework

# Web 根目錄（包含商戶入口）
# 容器內對應：/var/www/www.posdev
WEB_ROOT_PATH=/home/<username>/projects/www.posdev
# WEB_ROOT_PATH=/Users/<username>/projects/www.posdev
# WEB_ROOT_PATH=C:/Users/<username>/projects/www.posdev

# MyPOS KDS 專案目錄（Laravel）
# 容器內對應：/var/www/www.posdev/mypos_kds
# 需搭配 hosts: 127.0.0.1 mypos.posdev.test
MYPOS_KDS_PATH=/home/<username>/projects/mypos_kds
# MYPOS_KDS_PATH=/Users/<username>/projects/mypos_kds
# MYPOS_KDS_PATH=C:/Users/<username>/projects/mypos_kds

MYPOS_DEV3_PATH=/home/<username>/projects/mypos_dev3
# MYPOS_DEV3_PATH=/Users/<username>/projects/mypos_dev3
# MYPOS_DEV3_PATH=C:/Users/<username>/projects/mypos_dev3

# Notifier 通知服務專案
# 容器內對應：/var/www/notifier
NOTIFIER_PATH=/home/<username>/projects/notifier
# NOTIFIER_PATH=/Users/<username>/projects/notifier
# NOTIFIER_PATH=C:/Users/<username>/projects/notifier

# ================================================
# PHP 配置
# ================================================
# PHP 記憶體限制
PHP_MEMORY_LIMIT=512M

# PHP 最大上傳檔案大小
PHP_UPLOAD_MAX_FILESIZE=100M

# PHP POST 資料大小限制
PHP_POST_MAX_SIZE=100M

# PHP 最大執行時間 (秒)
PHP_MAX_EXECUTION_TIME=300

# PHP 時區 (IANA 格式，例: Asia/Taipei, UTC, America/New_York)
PHP_TIMEZONE=Asia/Taipei

# ================================================
# MySQL 配置
# ================================================
# InnoDB Buffer Pool 大小
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

# InnoDB Log File 大小
MYSQL_INNODB_LOG_FILE_SIZE=128M

# MySQL 伺服器時區 (影響 NOW(), CURDATE() 等函數)
# 格式: POSIX offset (+08:00, -05:00, +00:00)
MYSQL_TIMEZONE=+08:00

# 慢查詢時間閾值 (秒)
MYSQL_SLOW_QUERY_TIME=2

# ================================================
# 容器名稱前綴
# ================================================
COMPOSE_PROJECT_NAME=posdev
